PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=campuspass
# Atlas example: mongodb+srv://<username>:<url-encoded-password>@<cluster>.mongodb.net/campuspass?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-jwt-secret
SESSION_SECRET=replace-with-a-different-long-random-session-secret
FACULTY_CODE=campus-faculty-demo
NODE_ENV=development
